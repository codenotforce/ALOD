{
  "version": 2,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Portable Release with migration tests",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ALOD_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [{"name": "release", "configurePreset": "release", "jobs": 2}],
  "testPresets": [{"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}}]
}
